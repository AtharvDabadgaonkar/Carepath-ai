# Copy this file to .streamlit/secrets.toml and add your own key.
# .streamlit/secrets.toml is git-ignored and must never be committed.
#
# The application runs fully without this file: with no key configured the
# AI Conversion Copilot uses its deterministic fallback analyst and makes no
# network calls at all.

OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"
